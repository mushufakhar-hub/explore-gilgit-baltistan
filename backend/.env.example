# Explore Gilgit-Baltistan backend environment example
# Copy this file to .env and update the values before running the backend.

# Application runtime
APP_NAME="Explore Gilgit-Baltistan API"
ENVIRONMENT=development
DEBUG=true
SECRET_KEY=change-me-in-production

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/explore_gb

# Redis / Celery
REDIS_URL=redis://localhost:6379/0

# Webhook and payment settings
PAYMENT_WEBHOOK_SECRET=change-me-in-production

# CORS origins (comma-separated list)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Optional external integrations
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Clerk auth
CLERK_JWKS_URL=https://example.clerk.accounts.dev/.well-known/jwks.json
CLERK_ISSUER=https://example.clerk.accounts.dev
CLERK_SECRET_KEY=

# OpenAI and monitoring
OPENAI_API_KEY=
SENTRY_DSN=
